VITE_API_BASE_URL=
# Optional: set an absolute backend URL instead of the Vite /api proxy.
# VITE_API_BASE_URL=http://localhost:5000
# Optional: set an explicit WebSocket URL. Leave blank to derive it from the
# API base or the current origin (the Vite dev server proxies /ws).
# VITE_WS_URL=ws://localhost:5000/ws
# Optional: change the Vite proxy target.
# VITE_PROXY_TARGET=http://localhost:5000
