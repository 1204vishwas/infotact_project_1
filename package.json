{
  "name": "nexusflow-signup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/utils/*.test.js",
    "test:frontend": "node --test frontend/src/utils/*.test.js",
    "test:client": "node --test client/src/utils/*.test.js",
    "test:backend": "node --test backend/tests/*.test.js",
    "test:server": "node --test server/tests/*.test.js",
    "test:all": "node --test src/utils/*.test.js server/tests/*.test.js frontend/src/utils/*.test.js",
    "frontend": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend": "npm --prefix backend run dev",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "client": "npm --prefix client run dev",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server": "node server/index.js",
    "server:init": "node server/scripts/initTimeSeries.js",
    "server:benchmark": "node server/scripts/benchmark.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
